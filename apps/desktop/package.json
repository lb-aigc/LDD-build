{
  "name": "@ldd/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main/src/main/bootstrap.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@ldd/runtime-kit": "workspace:*",
    "@ldd/runtime-package": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/yauzl": "2.10.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "5.0.0",
    "electron": "37.0.0",
    "electron-builder": "26.0.0",
    "jsdom": "26.1.0",
    "vite": "7.0.0",
    "vitest": "4.0.0"
  },
  "build": {
    "appId": "com.ldd.desktop",
    "productName": "LDD",
    "artifactName": "LDD-Setup-${version}-x64.${ext}",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../vendor/runtime-host",
        "to": "runtime-host"
      },
      {
        "from": "../../dist/runtime/0.1.1-rc.2",
        "to": "runtime-fallback"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
