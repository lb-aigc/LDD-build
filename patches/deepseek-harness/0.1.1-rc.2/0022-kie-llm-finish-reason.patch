--- a/packages/llm/llm-pi-ai/src/stream.ts
+++ b/packages/llm/llm-pi-ai/src/stream.ts
@@ -110,6 +110,14 @@
     }
     case 'error': {
       const text = message.errorMessage ?? 'pi-ai stream error'
+      // KIE 等网关的 OpenAI 兼容端点不发送标准 finish_reason chunk——它们在
+      // `[DONE]` 前只发一个 choices 为空的 usage chunk——pi-ai 因此把已完整
+      // 流出的回复报成 "Stream ended without finish_reason"。此时 content 已经
+      // 完整，是正常的完成而非传输截断，按内容恢复为 stop / tool-calls。
+      if (message.content.length > 0 && /stream ended without finish_reason/i.test(text)) {
+        const hasToolCall = message.content.some((block) => block.type === 'toolCall')
+        return hasToolCall ? { kind: 'tool-calls' } : { kind: 'stop' }
+      }
       return { kind: 'error', failure: { message: text, code: classifyPiAiError(text) } }
     }
   }
