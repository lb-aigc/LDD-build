+/**
+ * LDD file-import bridge (upstream patch 0018): the composer's "can submit"
+ * test counts non-image files so a video-only draft is sendable. The generate
+ * plugin wires `__lddFileHooks.hasFiles` / `subscribeFiles`; absent in a stock
+ * Harness build this reads false and the composer behaves exactly as before.
+ */
+interface LddFileHooks {
+  readonly hasFiles?: (sessionId: SessionId | undefined) => boolean
+  readonly subscribeFiles?: (cb: () => void) => () => void
+}
+function lddFileHooks(): LddFileHooks {
+  return (globalThis as { __lddFileHooks?: LddFileHooks }).__lddFileHooks ?? {}
+}
+function useImportedFileCount(sessionId: SessionId | undefined): boolean {
+  return useSyncExternalStore(
+    (cb) => lddFileHooks().subscribeFiles?.(cb) ?? (() => {}),
+    () => lddFileHooks().hasFiles?.(sessionId) ?? false,
+  )
+}
 
