+
+/** LDD file hooks wired by the generate plugin (absent in stock Harness): fold
+ *  staged non-image files into the prompt text, and clear them after send. */
+interface LddFileHooks {
+  readonly inject?: (sessionId: SessionId, text: string) => string
+  readonly commit?: (sessionId: SessionId) => void
+}
+
+function lddFileHooks(): LddFileHooks {
+  return (globalThis as { __lddFileHooks?: LddFileHooks }).__lddFileHooks ?? {}
+}
+
+function injectLddImportedFiles(sessionId: SessionId, text: string): string {
+  return lddFileHooks().inject?.(sessionId, text) ?? text
+}
+
+function commitLddImportedFiles(sessionId: SessionId): void {
+  lddFileHooks().commit?.(sessionId)
+}
