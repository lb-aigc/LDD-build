+
+/* Collapse: a long block (a full prompt fence, a pasted source file) caps to a
+   fixed-height window with a fade and an expand toggle, so it does not flood
+   the chat. The collapse is purely visual — the copy control still reads the
+   complete <pre> text, and the block is line-count gated so short blocks never
+   collapse. */
+.bodyCollapsed {
+  max-height: 400px;
+  overflow: hidden;
+  position: relative;
+}
+
+.bodyCollapsed::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: 48px;
+  background: linear-gradient(to bottom, transparent, var(--dsl-code-block-background));
+  pointer-events: none;
+}
+
+.expand {
+  display: block;
+  width: 100%;
+  padding: 10px 16px;
+  border: none;
+  background-color: var(--dsl-code-block-background);
+  color: var(--dsw-alias-label-tertiary);
+  cursor: pointer;
+  font: inherit;
+  text-align: center;
+  border-bottom-left-radius: var(--dsl-code-block-border-radius);
+  border-bottom-right-radius: var(--dsl-code-block-border-radius);
+}
+
+.expand:hover {
+  color: var(--dsw-alias-label-secondary);
+}
