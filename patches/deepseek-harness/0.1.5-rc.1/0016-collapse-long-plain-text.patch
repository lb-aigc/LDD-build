+/**
+ * A long, structurally-flat reply (a full prompt, a pasted blob) collapses
+ * into a copyable, height-capped code block so it does not flood the chat.
+ * Only flat paragraph-only documents qualify — a structured reply (headings,
+ * lists, tables, fences) keeps its normal rendering, since those blocks carry
+ * meaning the collapse would flatten away. Applied on the settled render only,
+ * so streaming never jumps between collapsed and expanded.
+ */
+function isCollapsiblePlainText(root: Root, text: string): boolean {
+  if (root.children.length === 0) return false
+  if (!root.children.every(node => node.type === 'paragraph')) return false
+  return text.length > DEFAULT_CODE_MAX_CHARS || text.split('\n').length > DEFAULT_CODE_MAX_LINES
